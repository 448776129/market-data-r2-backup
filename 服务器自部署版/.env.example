# market-data-r2 环境变量模板
# 复制为 /opt/market-data-r2/.env 并填入真实值

# ── R2（S3 兼容，直连）──
R2_ACCOUNT_ID=8e43ef2043266e0898cf9e02ca53df2f
R2_ACCESS_KEY_ID=你的_Access_Key_ID
R2_SECRET_ACCESS_KEY=你的_Secret_Access_Key
R2_BUCKET=stocks-api2

# ── Cloudflare KV（选股快照等写入）──
CLOUDFLARE_API_TOKEN=你的_API_Token
CLOUDFLARE_ACCOUNT_ID=8e43ef2043266e0898cf9e02ca53df2f
KV_NAMESPACE_ID=6ec220d973654f7981364ac1340863df

# ── Yahoo 访问方式（全默认直连）──
# 分钟K纯Python脚本：YAHOO_DIRECT=1 直连；国内设 0 走反代
YAHOO_DIRECT=1
# 其他脚本（fetch_history/sync_incremental/news）：YAHOO_USE_PROXY=1 走反代；留空直连
YAHOO_USE_PROXY=

# ── 其余（可按需调整）──
FETCH_CONCURRENCY=10